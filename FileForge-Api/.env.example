# Backend-only settings. Copy to .env (git-ignored) and fill in. Never put these in FileForge-WebUi.
NODE_ENV=development
PORT=4000
# LOG_LEVEL=debug

# Browser origin of the React app (the only allowed CORS origin and the post-login redirect target).
FRONTEND_URL=http://localhost:3000
# Set to true only behind a TLS-terminating reverse proxy (needed for Secure cookies there).
TRUST_PROXY=false

# Microsoft Entra ID app registration "FileForge AI" (Web platform, confidential client).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/auth/microsoft/callback

# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_MINUTES=480

# PostgreSQL (fileforge_db). Use sslmode=require for Azure Database for PostgreSQL.
DATABASE_URL=

# Central Storage (all users' files in the administrator's OneDrive). REQUIRED: the API refuses to start without it.
# AES-256-GCM key that encrypts the central OneDrive token cache in PostgreSQL. Generate a NEW random key per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and backed up separately from the database: without it the stored cache cannot be decrypted
# (the administrator then just reconnects OneDrive). Never commit a real value.
CENTRAL_STORAGE_ENCRYPTION_KEY=
# Number of the current key. Only change it together with a key rotation.
CENTRAL_STORAGE_ENCRYPTION_KEY_VERSION=1

# ---- Sessions (REQUIRED in production) ----------------------------------------------------------------------------------
# memory   = development only (sessions vanish on restart; cannot be shared between instances). Production refuses it.
# postgres = sessions stored in core.sessions as AES-256-GCM ciphertext. Needs SESSION_ENCRYPTION_KEY.
SESSION_STORE=memory
# A SEPARATE key from CENTRAL_STORAGE_ENCRYPTION_KEY (the API refuses to start if they are equal). Generate a NEW one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it signs every user out (they simply sign in again). Never commit a real value.
SESSION_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY_VERSION=1

# ---- PostgreSQL connection budget ---------------------------------------------------------------------------------------
# Azure Database for PostgreSQL allows 50 connections and reserves about 10, so ~40 are usable by ALL instances and tools together.
# Each backend instance opens DATABASE_POOL_MAX (+ SESSION_STORE_POOL_MAX with SESSION_STORE=postgres).
# The API refuses to start if DATABASE_INSTANCE_COUNT x (DATABASE_POOL_MAX + SESSION_STORE_POOL_MAX) > DATABASE_CONNECTION_LIMIT.
# Leave room for pgAdmin / migrations. Example: 3 instances x (10 + 3) = 39.
DATABASE_POOL_MAX=10
SESSION_STORE_POOL_MAX=3
DATABASE_INSTANCE_COUNT=1
DATABASE_CONNECTION_LIMIT=40

# ---- Central Storage: upload limits (shared by every instance through PostgreSQL) ---------------------------------------
# Approved defaults; change only deliberately. Exceeding a limit answers 429 with a Retry-After header.
CENTRAL_UPLOAD_WINDOW_MINUTES=10
CENTRAL_UPLOAD_USER_LIMIT=10
CENTRAL_REPLACE_USER_LIMIT=10
CENTRAL_ADMIN_UPLOAD_LIMIT=60
CENTRAL_UPLOAD_MAX_CONCURRENT_PER_USER=3
CENTRAL_UPLOAD_MAX_CONCURRENT_GLOBAL=8
# Frees the slot of a request whose instance died. Must outlast the slowest legitimate upload.
CENTRAL_UPLOAD_SLOT_LEASE_MINUTES=15

# ---- Central Storage: recovery of interrupted operations ----------------------------------------------------------------
# OFF by default. Turn it on deliberately: it finishes/undoes interrupted uploads, replacements and deletes in the central
# OneDrive. It never deletes an item just because a record says "failed" (those are flagged for an administrator).
# The recovery page (/admin/storage/recovery) works whether or not the automatic worker is on.
CENTRAL_RECOVERY_ENABLED=false
CENTRAL_RECOVERY_INTERVAL_SECONDS=60
# Only files untouched for this long are examined. Must be LONGER than CENTRAL_UPLOAD_SLOT_LEASE_MINUTES.
CENTRAL_RECOVERY_STALE_MINUTES=30
CENTRAL_RECOVERY_BATCH_SIZE=10
CENTRAL_RECOVERY_MAX_ATTEMPTS=6
CENTRAL_RECOVERY_LEASE_MINUTES=5
