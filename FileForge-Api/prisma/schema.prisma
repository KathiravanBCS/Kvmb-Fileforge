  user_id                BigInt?
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @default(now()) @db.Timestamptz(6)
  expires_at             DateTime @db.Timestamptz(6)
  users                  users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expires_at], map: "ix_sessions_expires")
  @@index([user_id], map: "ix_sessions_user", where: raw("(user_id IS NOT NULL)"))
  @@schema("public")
}

/// Centralized contacts: one table for the contacts of EVERY module, scoped to a workspace. source_type_id + source_record_id say
/// where a contact first came from; contact_entity_links records every record (of any entity type) it is linked to.
model contacts {
  id                   BigInt                 @id @default(autoincrement())
  workspace_id         BigInt
  display_name         String                 @db.VarChar(240)
  first_name           String?                @db.VarChar(120)
  last_name            String?                @db.VarChar(120)
  organization         String?                @db.VarChar(240)
  job_title            String?                @db.VarChar(180)
  department           String?                @db.VarChar(180)
  notes                String?
  source_type_id       BigInt?
  source_record_id     BigInt?
  review_status        String                 @default("unreviewed") @db.VarChar(25)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  created_by           BigInt?
  updated_at           DateTime?              @db.Timestamptz(6)
  updated_by           BigInt?
  is_deleted           Boolean                @default(false)
  deleted_at           DateTime?              @db.Timestamptz(6)
  deleted_by           BigInt?
  workspaces           workspaces             @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contact_source_types contact_source_types?  @relation(fields: [source_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contact_methods      contact_methods[]
  contact_addresses    contact_addresses[]
  contact_entity_links contact_entity_links[]
  business_card_scans  business_card_scans[]

  @@unique([id, workspace_id], map: "uq_contact_id_workspace")
  @@index([workspace_id, id(sort: Desc)], map: "ix_contacts_workspace", where: raw("(NOT is_deleted)"))
  @@schema("public")
}

/// E-mail addresses, phone numbers, websites and social profiles of a contact. method_type is the kind; label says which
/// (mobile, work, linkedin, github, ...). E-mail values are stored lowercase.
model contact_methods {
  id           BigInt     @id @default(autoincrement())
  workspace_id BigInt
  contact_id   BigInt
  method_type  String     @db.VarChar(25)
  label        String?    @db.VarChar(40)
  value        String
  is_primary   Boolean    @default(false)
  is_verified  Boolean    @default(false)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  created_by   BigInt?
  updated_at   DateTime?  @db.Timestamptz(6)
  updated_by   BigInt?
  is_deleted   Boolean    @default(false)
  deleted_at   DateTime?  @db.Timestamptz(6)
  deleted_by   BigInt?
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts     contacts   @relation(fields: [contact_id, workspace_id], references: [id, workspace_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contact_method_workspace")

  @@index([contact_id], map: "ix_contact_methods_contact", where: raw("(NOT is_deleted)"))
  @@index([workspace_id, method_type, value], map: "ix_contact_methods_lookup", where: raw("(NOT is_deleted)"))
  @@schema("public")
}

model contact_addresses {
  id           BigInt     @id @default(autoincrement())
  workspace_id BigInt
  contact_id   BigInt
  address_type String?    @db.VarChar(30)
  line1        String?
  city         String?    @db.VarChar(120)
  region       String?    @db.VarChar(120)
  postal_code  String?    @db.VarChar(30)
  country      String?    @db.VarChar(120)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  created_by   BigInt?
  updated_at   DateTime?  @db.Timestamptz(6)
  updated_by   BigInt?
  is_deleted   Boolean    @default(false)
  deleted_at   DateTime?  @db.Timestamptz(6)
  deleted_by   BigInt?
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts     contacts   @relation(fields: [contact_id, workspace_id], references: [id, workspace_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contact_address_workspace")

  @@index([contact_id], map: "ix_contact_addresses_contact", where: raw("(NOT is_deleted)"))
  @@schema("public")
}

/// Links a contact to any record of any module: entity_type_id (master.entity_types) + entity_id. A business card scan is
/// entity type 'business_card_scan'; every future module links its own records the same way.
model contact_entity_links {
  id                BigInt       @id @default(autoincrement())
  workspace_id      BigInt
  contact_id        BigInt
  entity_type_id    BigInt
  entity_id         BigInt
  relationship_type String       @default("source") @db.VarChar(60)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  created_by        BigInt?
  updated_at        DateTime?    @db.Timestamptz(6)
  updated_by        BigInt?
  is_deleted        Boolean      @default(false)
  deleted_at        DateTime?    @db.Timestamptz(6)
  deleted_by        BigInt?
  workspaces        workspaces   @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entity_types      entity_types @relation(fields: [entity_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts          contacts     @relation(fields: [contact_id, workspace_id], references: [id, workspace_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_entity_contact_workspace")

  @@unique([workspace_id, contact_id, entity_type_id, entity_id, relationship_type], map: "uq_contact_entity_link")
  @@index([entity_type_id, entity_id], map: "ix_contact_entity_links_entity")
  @@schema("public")
}

/// One scanned business card. The image lives in the central OneDrive (central_file_id); raw_extraction is what the model
/// returned, normalized_data is the validated (and possibly user-corrected) data. Approving it creates or updates the contact.
model business_card_scans {
  id                   BigInt         @id @default(autoincrement())
  workspace_id         BigInt
  owner_user_id        BigInt
  central_file_id      BigInt
  /// The photo of the BACK of the card, when there is one. Both photos are read together.
  back_central_file_id BigInt?
  contact_id           BigInt?
  raw_extraction       Json           @default("{}")
  normalized_data      Json           @default("{}")
  extraction_model     String         @db.VarChar(100)
  review_status        String         @default("pending") @db.VarChar(25)
  reviewed_at          DateTime?      @db.Timestamptz(6)
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  created_by           BigInt?
  updated_at           DateTime?      @db.Timestamptz(6)
  updated_by           BigInt?
  is_deleted           Boolean        @default(false)
  deleted_at           DateTime?      @db.Timestamptz(6)
  deleted_by           BigInt?
  workspaces           workspaces     @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                users          @relation(fields: [owner_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  central_files        central_files  @relation("business_card_scan_front", fields: [central_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  back_central_files   central_files? @relation("business_card_scan_back", fields: [back_central_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts             contacts?      @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspace_id, owner_user_id, id(sort: Desc)], map: "ix_business_card_scans_owner", where: raw("(NOT is_deleted)"))
  @@index([central_file_id], map: "ix_business_card_scans_file")
  @@index([back_central_file_id], map: "ix_business_card_scans_back_file", where: raw("(back_central_file_id IS NOT NULL)"))
  @@index([contact_id], map: "ix_business_card_scans_contact", where: raw("(contact_id IS NOT NULL)"))
  @@schema("public")
}
