  workspace_id            BigInt
  connection_id           BigInt
  module_code             String      @db.VarChar(80)
  folder_name             String      @db.VarChar(255)
  external_folder_item_id String?
  relative_path           String
  is_active               Boolean     @default(true)
  created_at              DateTime    @default(now()) @db.Timestamptz(6)
  created_by              BigInt?
  updated_at              DateTime?   @db.Timestamptz(6)
  updated_by              BigInt?
  is_deleted              Boolean     @default(false)
  deleted_at              DateTime?   @db.Timestamptz(6)
  deleted_by              BigInt?
  connections             connections @relation(fields: [connection_id, workspace_id], references: [id, workspace_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_folder_mapping_connection_workspace")
  workspaces              workspaces  @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([connection_id, module_code], map: "uq_folder_mapping_active", where: raw("(NOT is_deleted)"))
  @@index([workspace_id], map: "ix_folder_mapping_workspace", where: raw("(NOT is_deleted)"))
  @@schema("storage")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model operations {
  id            BigInt       @id @default(autoincrement())
  workspace_id  BigInt
  file_id       BigInt?
  connection_id BigInt?
  operation     String       @db.VarChar(30)
  status        String       @db.VarChar(30)
  details       Json         @default("{}")
  error_message String?
  performed_at  DateTime     @default(now()) @db.Timestamptz(6)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  created_by    BigInt?
  updated_at    DateTime?    @db.Timestamptz(6)
  updated_by    BigInt?
  is_deleted    Boolean      @default(false)
  deleted_at    DateTime?    @db.Timestamptz(6)
  deleted_by    BigInt?
  connections   connections? @relation(fields: [connection_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  files         files?       @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaces    workspaces   @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_operations_active", where: raw("(is_deleted = false)"))
  @@index([workspace_id], map: "ix_operations_workspace")
  @@schema("storage")
}



/// Global administrators. READ-ONLY for the application: rows are created only by reviewed SQL.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model system_admins {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  is_active  Boolean   @default(true)
  granted_by BigInt?
  granted_at DateTime  @default(now()) @db.Timestamptz(6)
  note       String?   @db.VarChar(300)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  created_by BigInt?
  updated_at DateTime? @db.Timestamptz(6)
  updated_by BigInt?
  is_deleted Boolean   @default(false)
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by BigInt?
  users_system_admins_user_idTousers    users  @relation("system_admins_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_system_admins_granted_byTousers users? @relation("system_admins_granted_byTousers", fields: [granted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Partial unique: use findFirst with is_deleted: false, never findUnique.
  @@unique([user_id], map: "uq_system_admins_user", where: raw("(is_deleted = false)"))
  @@index([id], map: "ix_system_admins_active", where: raw("(is_deleted = false)"))
  @@schema("core")
}

/// The single designated central OneDrive connection. The MSAL cache is stored only as AES-256-GCM ciphertext.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model central_connection {
  id                     BigInt                 @id @default(autoincrement())
  provider_type_id       BigInt
  owner_user_id          BigInt
  account_issuer         String
  account_subject        String
  account_tenant_id      String?                @db.VarChar(100)
  account_type           String                 @default("unknown") @db.VarChar(30)
  home_account_id        String                 @db.VarChar(255)
  account_email          String?                @db.VarChar(320)
  account_display_name   String?                @db.VarChar(200)
  external_drive_id      String
  root_folder_item_id    String
  root_folder_path       String                 @default("FileForge-Central")
  users_folder_item_id   String
  connection_status      String                 @default("unverified") @db.VarChar(30)
  consented_scopes       String[]
  token_cache_ciphertext Bytes
  token_cache_nonce      Bytes
  token_cache_auth_tag   Bytes
  encryption_key_version Int                    @default(1) @db.SmallInt
  cache_revision         BigInt                 @default(1)
  cache_updated_at       DateTime               @default(now()) @db.Timestamptz(6)
  last_auth_at           DateTime?              @db.Timestamptz(6)
  last_verified_at       DateTime?              @db.Timestamptz(6)
  last_error_code        String?                @db.VarChar(60)
  last_error_at          DateTime?              @db.Timestamptz(6)
  quota_total_bytes      BigInt?
  quota_used_bytes       BigInt?
  quota_remaining_bytes  BigInt?
  quota_state            String?                @db.VarChar(20)
  quota_checked_at       DateTime?              @db.Timestamptz(6)
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  created_by             BigInt?
  updated_at             DateTime?              @db.Timestamptz(6)
  updated_by             BigInt?
  is_deleted             Boolean                @default(false)
  deleted_at             DateTime?              @db.Timestamptz(6)
  deleted_by             BigInt?
  users                  users                  @relation(fields: [owner_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storage_provider_types storage_provider_types @relation(fields: [provider_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  central_files          central_files[]

  @@index([id], map: "ix_central_connection_active", where: raw("(is_deleted = false)"))
  @@schema("storage")
}

/// Metadata of files in the central OneDrive. owner_user_id is the only basis for user access.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model central_files {
  id                        BigInt             @id @default(autoincrement())
  connection_id             BigInt
  owner_user_id             BigInt
  uploaded_by               BigInt
  display_name              String
  stored_name               String             @db.VarChar(100)
  file_extension            String?            @db.VarChar(16)
  mime_type                 String             @db.VarChar(255)
  size_bytes                BigInt             @default(0)
  checksum_sha256           String?            @db.VarChar(64)
  content_version           Int                @default(1)
  external_drive_id         String
  external_item_id          String?
  external_etag             String?
  external_ctag             String?
  external_created_at       DateTime?          @db.Timestamptz(6)
  external_last_modified_at DateTime?          @db.Timestamptz(6)
  upload_status             String             @default("pending") @db.VarChar(30)
  uploaded_at               DateTime?          @db.Timestamptz(6)
  last_error_code           String?            @db.VarChar(60)
  created_at                DateTime           @default(now()) @db.Timestamptz(6)
  created_by                BigInt?
  updated_at                DateTime?          @db.Timestamptz(6)
  updated_by                BigInt?
  is_deleted                Boolean            @default(false)
  deleted_at                DateTime?          @db.Timestamptz(6)
  deleted_by                BigInt?
  recovery_attempts         Int                @default(0) @db.SmallInt
  next_recovery_at          DateTime?          @db.Timestamptz(6)
  last_recovery_at          DateTime?          @db.Timestamptz(6)
  last_recovery_outcome     String?            @db.VarChar(40)
  needs_review              Boolean            @default(false)
  review_reason             String?            @db.VarChar(80)
  pending_size_bytes        BigInt?
  pending_checksum_sha256   String?            @db.VarChar(64)
  recovery_lease_token      String?            @db.Uuid
  recovery_lease_until      DateTime?          @db.Timestamptz(6)
  central_connection        central_connection @relation(fields: [connection_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_central_files_owner_user_idTousers  users @relation("central_files_owner_user_idTousers", fields: [owner_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_central_files_uploaded_byTousers    users @relation("central_files_uploaded_byTousers", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Partial unique: use findFirst with is_deleted: false, never findUnique.
  @@unique([external_drive_id, external_item_id], map: "uq_central_file_item", where: raw("((external_item_id IS NOT NULL) AND (is_deleted = false))"))
  @@unique([owner_user_id, stored_name], map: "uq_central_file_stored_name")
  @@index([id], map: "ix_central_files_active", where: raw("(is_deleted = false)"))
  @@index([owner_user_id, created_at(sort: Desc)], map: "ix_central_files_owner", where: raw("(is_deleted = false)"))
  @@index([created_at(sort: Desc)], map: "ix_central_files_created", where: raw("(is_deleted = false)"))
  @@index([upload_status, updated_at], map: "ix_central_files_needs_attention", where: raw("(upload_status IN ('pending', 'uploading', 'replacing', 'deleting', 'failed'))"))
  @@index([next_recovery_at, id], map: "ix_central_files_recovery_due", where: raw("((upload_status IN ('pending', 'uploading', 'replacing', 'deleting', 'failed')) AND (needs_review = false))"))
  @@index([updated_at(sort: Desc)], map: "ix_central_files_review", where: raw("(needs_review = true)"))
  @@schema("storage")
}

/// Append-only audit trail (UPDATE/DELETE are rejected by a trigger). Written for administrator actions on other users' files.
/// workspace_id / actor_user_id / entity_type_id are plain columns here: no relations, so no existing model changes.
model events {
  id             BigInt   @id @default(autoincrement())
  workspace_id   BigInt?
  actor_user_id  BigInt?
  actor_type     String   @default("user") @db.VarChar(20)
  action         String   @db.VarChar(80)
  entity_type_id BigInt?
  entity_id      BigInt?
  old_values     Json?
  new_values     Json?
  request_id     String?
  ip_address     String?  @db.Inet
  occurred_at    DateTime @default(now()) @db.Timestamptz(6)

  @@schema("audit")
}

/// Upload admission control (rate window, per-user and global concurrency), shared by every backend instance.
/// A slot is released only with its own lease_token. Times are compared with the database clock.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model central_upload_slots {
  id               BigInt    @id @default(autoincrement())
  user_id          BigInt
  operation        String    @db.VarChar(20)
  request_id       String?
  lease_token      String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  lease_expires_at DateTime  @db.Timestamptz(6)
  released_at      DateTime? @db.Timestamptz(6)
  outcome          String?   @db.VarChar(20)
  users            users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, operation, created_at(sort: Desc)], map: "ix_central_upload_slots_user_recent")
  @@index([user_id, lease_expires_at], map: "ix_central_upload_slots_open", where: raw("(released_at IS NULL)"))
  @@index([created_at], map: "ix_central_upload_slots_created")
  @@schema("storage")
}

/// Persistent server-side sessions. The payload is AES-256-GCM ciphertext (key SESSION_ENCRYPTION_KEY); the key of a row is
/// sha256(session id). Read and written by EncryptedPgSessionStore through the pg driver, not through this client.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sessions {
  sid_hash               Bytes     @id
  payload_ciphertext     Bytes
  payload_nonce          Bytes
  payload_auth_tag       Bytes
  encryption_key_version Int       @default(1) @db.SmallInt
  user_id                BigInt?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)
  expires_at             DateTime  @db.Timestamptz(6)
  users                  users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expires_at], map: "ix_sessions_expires")
  @@index([user_id], map: "ix_sessions_user", where: raw("(user_id IS NOT NULL)"))
  @@schema("core")
}
